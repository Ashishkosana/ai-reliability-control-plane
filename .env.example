# Copy to .env for local overrides. Never commit .env.

# Dedicated database. Do not point this at the workflow-engine DB name.
DATABASE_URL=postgresql://workflow:workflow@127.0.0.1:5432/aicp

API_HOST=0.0.0.0
API_PORT=43190
DEMO_MODE=false
LOG_LEVEL=INFO
PROMOTE_THRESHOLD=0.8
MAX_BODY_BYTES=200000
TRACE_ASYNC=true
TRACE_QUEUE_SIZE=4096

# Unused in V1. Fake provider is the laboratory. A real SDK is a provider swap.
OPENAI_API_KEY=
DEFAULT_PROVIDER=fake
